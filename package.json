{
  "name": "ll-server",
  "version": "0.1.0",
  "private": true,
  "packageManager": "yarn@4.18.1",
  "description": "NestJS, TypeORM and PostgreSQL backend for the learning app",
  "scripts": {
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:status": "docker compose ps"
  },
  "engines": {
    "node": "^22.13.0 || >=24.11.0"
  },
  "dependencies": {
    "@nestjs/common": "^12.1.3",
    "@nestjs/core": "^12.1.3",
    "@nestjs/platform-express": "^12.1.3",
    "@nestjs/typeorm": "^12.0.2",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^1.1.2"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.2"
  }
}
